---
import { IconProps as IconPropsZod } from "~/types/MeowIcons";
import {z} from "astro/zod"
import AeralisIcon from "./icons/AeralisIcon.astro";
import SlateIcon from "./icons/SlateIcon.astro";
import OpenMarchIcon from "./icons/OpenMarchIcon.astro";

type IconProps = z.infer<typeof IconPropsZod>;
interface Props {
  icon: IconProps
  class?: string
}
const { icon, class: className} = Astro.props;
---

{icon === "aeralis" ? <AeralisIcon class={className} /> : icon === "slate" ? <SlateIcon class={className} /> : icon === "openmarch" ? <OpenMarchIcon class={className} /> : <></>}
