---
import SlateIcon from "~/icons/slate.svg";
import KnobPanel from "./ui/KnobPanel.svelte";

const links = [
    {
        id: "discord",
        label: "DISCORD",
    },
    {
        id: "instagram",
        label: "INSTAGRAM",
        href: "https://www.instagram.com/jcbdkc/",
    },
    {
        id: "email",
        label: "EMAIL",
        href: "mailto:hello@jcbdkc.me",
    },
    {
        id: "you",
        label: "YOU ARE HERE",
    },
];
---

<script>
    import { ce3Store } from "~/utils/ce3store";
    import bg0 from "~/assets/ce3Bg/bg0.svg";
    import bg1 from "~/assets/ce3Bg/bg1.svg";
    import bg2 from "~/assets/ce3Bg/bg2.svg";
    import bg3 from "~/assets/ce3Bg/bg3.svg";

    const ce3BgImages: Record<number, string> = {
        0: bg0.src,
        1: bg1.src,
        2: bg2.src,
        3: bg3.src,
    };

    function randomPosition(
        width: number,
        height: number,
        elementWidth: number,
        elementHeight: number,
        offsetX: number,
        offsetY: number,
    ) {
        const padding = 8;

        const minX = Math.min(
            Math.max(padding, offsetX),
            Math.max(padding, width - elementWidth - padding),
        );

        const minY = Math.min(
            Math.max(padding, offsetY),
            Math.max(padding, height - elementHeight - padding),
        );

        const maxX = Math.max(padding, width - elementWidth - padding);
        const maxY = Math.max(padding, height - elementHeight - padding);

        return {
            x: minX + Math.random() * (maxX - minX),
            y: minY + Math.random() * (maxY - minY),
        };
    }

    function updatePositions(value: {
        pos: number;
        pos89: number;
        meowMax: number;
    }) {
        const map = document.getElementById("map") as HTMLElement;
        map.style.backgroundImage = `url(${ce3BgImages[value.meowMax]})`;

        if (!map) return;

        const { width, height } = map.getBoundingClientRect();

        Array.from(map.children).forEach((element) => {
            const el = element as HTMLElement;

            const { width: elWidth, height: elHeight } =
                el.getBoundingClientRect();

            const { x, y } = randomPosition(
                width,
                height,
                elWidth,
                elHeight,
                value.pos89,
                value.pos,
            );

            el.style.transform = `translate(${x}px, ${y}px)`;
        });
    }

    const unsubscribe = ce3Store.subscribe(updatePositions);

    document.addEventListener("astro:before-swap", unsubscribe);
</script>

<section class="flex flex-col items-center relative">
    <div class="w-77 h-fit bg-mic rounded-14 rounded-b-none shadow-wow p-2.5 flex flex-col gap-2.5">
        <div class="flex w-full justify-between items-center">
            <h3 class="font-titre font-bold text-shadow-wow">
                CONTACT_ESTABLISHER
            </h3>
            <h3 class="font-titre text-shadow-wow">SLT_CE3</h3>
            <img src={SlateIcon.src} alt="Slate" class="invert size-4.5" />
        </div>
        <KnobPanel client:load />
    </div>
    <div class="size-83 bg-mic rounded-14 shadow-wow p-2.5">
        <div
            id="map"
            class="rounded-sm w-full h-full overflow-clip relative bg-cover"
        >
            {links.map((link) =>
                link.href ? (
                    <a
                        class="absolute w-fit h-fit flex flex-col items-center hover:brightness-125 duration-150 active:brightness-75"
                        href={link.href}
                        target={
                            link.href.startsWith("https") ? "_blank" : undefined
                        }
                        rel={
                            link.href.startsWith("https")
                                ? "noopener noreferrer"
                                : undefined
                        }
                        aria-label={link.label}
                    >
                        <p class="font-titre text-poo">{link.label}</p>
                        <div class="size-3 rounded-full bg-poo"></div>
                    </a>
                ) : (
                    <div class="absolute w-fit h-fit flex flex-col items-center">
                        <p
                            class={`font-titre ${link.id === "you" ? "text-mic" : "text-poo"}`}
                        >
                            {link.label}
                        </p>
                        <div
                            class={`size-3 rounded-full ${link.id === "you" ? "bg-mic" : "bg-poo"}`}
                        ></div>
                    </div>
                ),
            )}
        </div>
    </div>
</section>
