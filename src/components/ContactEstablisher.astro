---
import SlateIcon from "~/icons/slate.svg";
import KnobPanel from "./ui/KnobPanel.svelte";
---

<script>
    import { ce3Store } from "~/utils/ce3store";

    ce3Store.subscribe((value) => {
        const map = document.getElementById("map");
        const height = map.clientHeight;
        const width = map.clientWidth;
        const box = document.getElementById("discord");

        let randY = Math.floor(Math.random() * height + value.pos);
        let randX = Math.floor(Math.random() * width + value.pos89);
        box.style.transform = `translate(${randX}px, ${randY}px)`;
    });
</script>

<section class="flex flex-col items-center relative">
    <div class="w-77 h-fit bg-mic rounded-14 rounded-b-none shadow-wow p-2.5 flex flex-col gap-2.5">
        <div class="flex w-full justify-between items-center">
            <h3 class="font-titre font-bold text-shadow-wow">
                CONTACT_ESTABLISHER
            </h3>
            <h3 class="font-titre text-shadow-wow">SLT_CE3</h3>
            <img src={SlateIcon.src} alt="Slate" class="invert size-4.5" />
        </div>
        <KnobPanel client:load />
    </div>
    <div class="size-83 bg-mic rounded-14 shadow-wow p-2.5">
        <div class="bg-black rounded-sm w-full h-full overflow-clip" id="map">
            <div
                class="w-fit h-fit flex flex-col items-center hover:brightness-125 duration-150 active:brightness-75"
                aria-label="Discord"
                id="discord"
            >
                <p class="font-titre text-poo">DISCORD</p>
                <div class="size-3 rounded-full bg-poo"></div>
            </div>
            <a
                class="w-fit h-fit flex flex-col items-center hover:brightness-125 duration-150 active:brightness-75"
                href="https://www.instagram.com/jcbdkc/"
                target="_blank"
                aria-label="Instagram"
                id="discord"
            >
                <p class="font-titre text-poo">INSTAGRAM</p>
                <div class="size-3 rounded-full bg-poo"></div>
            </a>
            <a
                class="w-fit h-fit flex flex-col items-center hover:brightness-125 duration-150 active:brightness-75"
                href="mailto:hello@jcbdkc.me"
                aria-label="Email"
                id="discord"
            >
                <p class="font-titre text-poo">EMAIL</p>
                <div class="size-3 rounded-full bg-poo"></div>
            </a>
            <div
                class="w-fit h-fit flex flex-col items-center hover:brightness-125 duration-150 active:brightness-75"
                id="discord"
            >
                <p class="font-titre text-mic">YOU ARE HERE</p>
                <div class="size-3 rounded-full bg-mic"></div>
            </div>
        </div>
    </div>
</section>
