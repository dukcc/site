---
import SlateIcon from "~/icons/slate.svg";
import KnobPanel from "./ui/KnobPanel.svelte";

const links = [
    {
        id: "discord",
        label: "DISCORD",
    },
    {
        id: "instagram",
        label: "INSTAGRAM",
        href: "https://www.instagram.com/jcbdkc/",
    },
    {
        id: "email",
        label: "EMAIL",
        href: "mailto:hello@jcbdkc.me",
    },
    {
        id: "you",
        label: "YOU ARE HERE",
    },
];
---

<script>
    import { ce3Store } from "~/utils/ce3store";

    function randomPosition(
        width: number,
        height: number,
        offsetX: number,
        offsetY: number,
    ) {
        return {
            x: Math.floor(Math.random() * width + offsetX),
            y: Math.floor(Math.random() * height + offsetY),
        };
    }

    function updatePositions(value: { pos: number; pos89: number }) {
        const map = document.getElementById("map");
        if (!map) return;

        const { width, height } = map.getBoundingClientRect();

        const positions = [...map.children];

        positions.forEach((element) => {
            const { x, y } = randomPosition(
                width,
                height,
                value.pos89,
                value.pos,
            );

            (element as HTMLElement).style.transform =
                `translate(${x}px, ${y}px)`;
        });
    }

    const unsubscribe = ce3Store.subscribe(updatePositions);

    document.addEventListener("astro:before-swap", unsubscribe);
</script>

<section class="flex flex-col items-center relative">
    <div class="w-77 h-fit bg-mic rounded-14 rounded-b-none shadow-wow p-2.5 flex flex-col gap-2.5">
        <div class="flex w-full justify-between items-center">
            <h3 class="font-titre font-bold text-shadow-wow">
                CONTACT_ESTABLISHER
            </h3>
            <h3 class="font-titre text-shadow-wow">SLT_CE3</h3>
            <img src={SlateIcon.src} alt="Slate" class="invert size-4.5" />
        </div>
        <KnobPanel client:load />
    </div>
    <div class="size-83 bg-mic rounded-14 shadow-wow p-2.5">
        <div
            id="map"
            class="bg-black rounded-sm w-full h-full overflow-clip relative"
        >
            {links.map((link) =>
                link.href ? (
                    <a
                        class="absolute w-fit h-fit flex flex-col items-center hover:brightness-125 duration-150 active:brightness-75"
                        href={link.href}
                        target={
                            link.href.startsWith("https") ? "_blank" : undefined
                        }
                        rel={
                            link.href.startsWith("https")
                                ? "noopener noreferrer"
                                : undefined
                        }
                        aria-label={link.label}
                    >
                        <p class="font-titre text-poo">{link.label}</p>
                        <div class="size-3 rounded-full bg-poo"></div>
                    </a>
                ) : (
                    <div class="absolute w-fit h-fit flex flex-col items-center">
                        <p
                            class={`font-titre ${link.id === "you" ? "text-mic" : "text-poo"}`}
                        >
                            {link.label}
                        </p>
                        <div
                            class={`size-3 rounded-full ${link.id === "you" ? "bg-mic" : "bg-poo"}`}
                        ></div>
                    </div>
                ),
            )}
        </div>
    </div>
</section>
