---
import { Font } from "astro:assets";
import "~/styles/base.css";

const { title } = Astro.props;
---

<html lang="en" class="">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>{title} ~ Jcbdkc</title>
        <Font cssVariable="--font-cossette" />
        <Font cssVariable="--font-cossette-titre" />
    </head>
    <body class="bg-bg overflow-x-hidden p-2 pt-64 flex flex-col items-center gap-32">
        <slot />
    </body>
</html>
