---
import Layout from "~/layouts/Layout.astro";
import JcbdkcLogo from "~/components/logos/JcbdkcLogo.astro";
import JcbdkcLogomark from "~/components/logos/JcbdkcLogomark.astro";
import Star from "~/components/logos/Star.astro";
import ContactEstablisher from "~/components/ContactEstablisher.astro";
import { getCollection } from 'astro:content';
import MeowIcons from "~/components/logos/MeowIcons.astro";

const meows = await getCollection("meows");
---

<Layout title="Home">
    <section class="grid grid-cols-5 w-full h-fit gap-2">
        <div class="flex flex-col gap-2">
            <div class="bg-mic col-span-1 p-4 flex rounded-lg">
                <h1 class="font-bold text-5xl font-titre leading-tight">
                    My Meows
                </h1>
            </div>
            {meows.sort((a, b) => b.data.date - a.data.date).map(meow => (
                <a
                    href={`/meows/${meow.id}`}
                    class="bg-mic hover:shadow-wow active:scale-95 active:shadow-none duration-150 col-span-1 p-4 gap-2 flex flex-col rounded-lg"
                >
                    <div class="flex gap-2 items-center">
                        <MeowIcons icon={meow.data.icon} />
                        <h2 class="text-2xl leading-tight">{meow.data.title}</h2>
                    </div>
                    <p class="leading-tight">
                        {meow.data.description}
                    </p>
                </a>
            ))}
        </div>
        <div class="bg-boo text-white col-span-4 p-16 flex flex-col items-center gap-16 rounded-lg">
            <div class="flex gap-2 items-start w-full justify-end">
                <JcbdkcLogo wowGradient size="lg" class="w-[35vw] h-auto" />
                <div class="size-17.5 bg-wow rounded-14 flex items-center justify-center"><JcbdkcLogomark class="size-12 text-black" /></div>
            </div>
            <p class="w-full text-left">HI GUYS!! Ok so I love creating web experiences. I focus on graphic design, mainly user interface, and building design systems.</p>
            <Star />
            <p class="w-full text-left">HI GUYS!! Ok so I love creating web experiences. I focus on graphic design, mainly user interface, and building design systems.</p>
            <Star />
            <p class="w-full text-left">HI GUYS!! Ok so I love creating web experiences. I focus on graphic design, mainly user interface, and building design systems.</p>
            <Star />
            <p class="w-full text-left">HI GUYS!! Ok so I love creating web experiences. I focus on graphic design, mainly user interface, and building design systems.</p>
            <ContactEstablisher />
        </div>
    </section>
</Layout>
